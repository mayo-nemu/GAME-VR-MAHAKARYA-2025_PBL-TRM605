      m_Calls: []
  m_text: 'Aku sudah meninggalkan rumah selama 3 hari, dan sekarang kebunku dipenuhi
    akar pohon. Bisa tolong hancurkan akar-akar itu? Aku tidak punya alat untuk melakukannya.

'
  m_isRightToLeft: 0
