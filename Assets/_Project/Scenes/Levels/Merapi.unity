  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Karena situasi saat ini tidak aman, hanya warga yang memiliki surat izin
    perjalanan yang diperbolehkan masuk ke area ini. Jika kamu memilikinya, silakan
    taruh surat itu di tunggul pohon ini. Terima kasih!
  m_isRightToLeft: 0
